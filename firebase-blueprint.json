    },
    "SponsoredPostDoc": {
      "title": "SponsoredPostDoc",
      "description": "Admin-managed sponsored promotion displayed in the community feed.",
      "type": "object",
      "properties": {
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "businessName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "ctaLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "actionUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 512,
          "pattern": "^(|https?://.*)$"
        },
        "status": {
          "type": "string",
          "enum": ["active", "paused"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["authorId", "businessName", "headline", "text", "ctaLabel", "actionUrl", "status", "createdAt", "updatedAt"]
    },
    "CallSessionDoc": {
      "title": "CallSessionDoc",
      "description": "WebRTC signaling session for 1-on-1 audio and video calls.",
      "type": "object",
      "properties": {
        "callerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "callerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "calleeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "calleeName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "callType": {
          "type": "string",
          "enum": ["audio", "video"]
        },
        "status": {
          "type": "string",
          "enum": ["ringing", "active", "ended", "declined"]
        },
        "offerSdp": {
          "type": "string",
          "minLength": 10,
          "maxLength": 20000
        },
        "answerSdp": {
          "type": "string",
          "minLength": 10,
          "maxLength": 20000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "callerId",
        "callerName",
        "calleeId",
        "calleeName",
        "callType",
        "status",
        "offerSdp",
        "createdAt",
        "updatedAt"
      ]
    },
    "CallCandidateDoc": {
      "title": "CallCandidateDoc",
      "description": "WebRTC ICE candidate exchanged during a call session.",
      "type": "object",
      "properties": {
        "senderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recipientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "candidate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "sdpMid": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "sdpMLineIndex": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["senderId", "recipientId", "candidate", "sdpMid", "sdpMLineIndex", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public profile documents for Al Amana Social members."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Private PII subcollection accessible only to the owning user."
    },
    "/users/{userId}/readStates/{roomId}": {
      "schema": { "$ref": "#/entities/UserReadStateDoc" },
      "description": "Owner-only read sequence cursors for unread badges on groups and channels."
    },
    "/follows/{followId}": {
      "schema": { "$ref": "#/entities/FollowEdge" },
      "description": "Follow relationships between members."
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "Community feed posts."
    },
    "/posts/{postId}/likes/{userId}": {
      "schema": { "$ref": "#/entities/PostLike" },
      "description": "Per-user like subcollection synchronized with Post.likesCount."
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/PostComment" },
      "description": "Comments belonging to a post."
    },
    "/media/{mediaId}": {
      "schema": { "$ref": "#/entities/MediaAssetDoc" },
      "description": "Public photo and short-video asset descriptors authored by members."
    },
    "/media/{mediaId}/chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/MediaChunkDoc" },
      "description": "Bounded base64 slices belonging to a media asset."
    },
    "/sponsored_posts/{adId}": {
      "schema": { "$ref": "#/entities/SponsoredPostDoc" },
      "description": "Admin-managed sponsored business promotions."
    },
    "/chats/{threadId}": {
      "schema": { "$ref": "#/entities/ChatThread" },
      "description": "Direct message thread metadata."
    },
    "/chats/{threadId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessageDoc" },
      "description": "Messages belonging to a direct message thread."
    },
    "/notifications/{notifId}": {
      "schema": { "$ref": "#/entities/NotificationDoc" },
      "description": "Activity notifications scoped to the recipient user."
    },
    "/groups/{groupId}": {
      "schema": { "$ref": "#/entities/GroupDoc" },
      "description": "Private multi-member group chats."
    },
    "/groups/{groupId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/GroupMessageDoc" },
      "description": "Messages inside a group chat."
    },
    "/groups/{groupId}/readReceipts/{userId}": {
      "schema": { "$ref": "#/entities/GroupReadReceiptDoc" },
      "description": "Per-member read receipts inside a group chat."
    },
    "/channels/{channelId}": {
      "schema": { "$ref": "#/entities/ChannelDoc" },
      "description": "Public and VIP broadcast channels."
    },
    "/channels/{channelId}/followers/{userId}": {
      "schema": { "$ref": "#/entities/ChannelFollowerDoc" },
      "description": "Per-user channel subscription marker."
    },
    "/channels/{channelId}/vipMembers/{userId}": {
      "schema": { "$ref": "#/entities/ChannelVipMemberDoc" },
      "description": "Creator-approved VIP members for a paid VIP channel."
    },
    "/channels/{channelId}/vipReceipts/{receiptId}": {
      "schema": { "$ref": "#/entities/ChannelVipReceiptDoc" },
      "description": "Submitted VIP payment receipts awaiting creator review."
    },
    "/channels/{channelId}/posts/{channelPostId}": {
      "schema": { "$ref": "#/entities/ChannelPostDoc" },
      "description": "Broadcast messages published inside a channel."
    },
    "/calls/{callId}": {
      "schema": { "$ref": "#/entities/CallSessionDoc" },
      "description": "1-on-1 WebRTC audio and video call signaling sessions."
    },
    "/calls/{callId}/callerCandidates/{candidateId}": {
      "schema": { "$ref": "#/entities/CallCandidateDoc" },
      "description": "ICE candidates emitted by the caller."
