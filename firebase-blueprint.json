          "minLength": 1,
          "maxLength": 2000
        },
        "messageType": {
          "type": "string",
          "enum": ["text", "voice"]
        },
        "audioData": {
          "type": "string",
          "minLength": 10,
          "maxLength": 350000
        },
        "audioDuration": {
          "type": "integer"
        },
        "seq": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["groupId", "senderId", "senderName", "visibleTo", "text", "createdAt"]
    },
