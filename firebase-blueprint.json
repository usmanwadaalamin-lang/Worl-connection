{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public social profile for an Al Amana Social member (PII excluded).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "handle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "pattern": "^@[a-zA-Z0-9_]+$"
        },
        "bio": {
          "type": "string",
          "minLength": 0,
          "maxLength": 280
        },
        "avatarUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160000
        },
        "isPublic": {
          "type": "boolean"
        },
        "isOnline": {
          "type": "boolean"
        },
        "lastActiveAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "name", "handle", "bio", "avatarUrl", "isPublic", "createdAt", "updatedAt"]
    },
    "UserReadStateDoc": {
      "title": "UserReadStateDoc",
      "description": "Per-user read sequence cursor for group and channel conversations.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "roomId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "lastReadSeq": {
          "type": "integer"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "roomId", "lastReadSeq", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Owner-only PII record containing member email address and/or phone number.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "phoneNumber": {
          "type": "string",
          "minLength": 5,
          "maxLength": 32
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "updatedAt"]
    },
    "FollowEdge": {
      "title": "FollowEdge",
      "description": "Directed follow relationship between two users.",
      "type": "object",
      "properties": {
        "followerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["followerId", "targetId", "createdAt"]
    },
    "Post": {
      "title": "Post",
      "description": "Community post authored by a member.",
      "type": "object",
      "properties": {
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "authorHandle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "pattern": "^@[a-zA-Z0-9_]+$"
        },
        "authorAvatarUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160000
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "likesCount": {
          "type": "integer"
        },
        "commentsCount": {
          "type": "integer"
        },
        "visibility": {
          "type": "string",
          "enum": ["public"]
        },
        "analysis": {
          "type": "string",
          "minLength": 0,
          "maxLength": 6000
        },
        "mediaId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mediaType": {
          "type": "string",
          "enum": ["image", "video"]
        },
        "mediaMimeType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80,
          "pattern": "^(image/(jpeg|jpg|png|webp)|video/(mp4|webm|quicktime))$"
        },
        "mediaPoster": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120000
        },
        "mediaDuration": {
          "type": "integer"
        },
        "mediaWidth": {
          "type": "integer"
        },
        "mediaHeight": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "authorId",
        "authorName",
        "authorHandle",
        "authorAvatarUrl",
        "text",
        "likesCount",
        "commentsCount",
        "visibility",
        "createdAt"
      ]
    },
    "MediaAssetDoc": {
      "title": "MediaAssetDoc",
      "description": "Metadata descriptor for an uploaded community photo or short video stored in bounded chunks.",
      "type": "object",
      "properties": {
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mediaType": {
          "type": "string",
          "enum": ["image", "video"]
        },
        "mimeType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80,
          "pattern": "^(image/(jpeg|jpg|png|webp)|video/(mp4|webm|quicktime))$"
        },
        "chunkCount": {
          "type": "integer"
        },
        "totalBytes": {
          "type": "integer"
        },
        "durationSec": {
          "type": "integer"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "visibility": {
          "type": "string",
          "enum": ["public"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "authorId",
        "mediaType",
        "mimeType",
        "chunkCount",
        "totalBytes",
        "durationSec",
        "width",
        "height",
        "visibility",
        "createdAt"
      ]
    },
    "MediaChunkDoc": {
      "title": "MediaChunkDoc",
      "description": "Bounded base64 binary slice belonging to a MediaAssetDoc.",
      "type": "object",
      "properties": {
        "mediaId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "index": {
          "type": "integer"
        },
        "data": {
          "type": "string",
          "minLength": 1,
          "maxLength": 660000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["mediaId", "authorId", "index", "data", "createdAt"]
    },
    "PostLike": {
      "title": "PostLike",
      "description": "Per-user like marker synchronized atomically with Post.likesCount.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "createdAt"]
    },
    "PostComment": {
      "title": "PostComment",
      "description": "Comment on a community post.",
      "type": "object",
      "properties": {
        "postId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "authorHandle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "pattern": "^@[a-zA-Z0-9_]+$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["postId", "authorId", "authorName", "authorHandle", "text", "createdAt"]
    },
    "ChatThread": {
      "title": "ChatThread",
      "description": "Two-party direct chat thread metadata.",
      "type": "object",
      "properties": {
        "participantA": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
