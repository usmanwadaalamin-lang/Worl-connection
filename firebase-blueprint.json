        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "read": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["recipientId", "actorId", "actorName", "type", "message", "read", "createdAt"]
    },
    "GroupDoc": {
      "title": "GroupDoc",
